{
  "manifest_version": 3,
  "name": "VibeNote Web Capturer",
  "version": "1.1.0",
  "description": "Capture system or tab audio from online meetings and stream them directly to the VibeNote dashboard.",
  "permissions": [
    "tabCapture",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://meet.google.com/*",
        "*://*.zoom.us/*",
        "*://teams.microsoft.com/*",
        "*://teams.live.com/*",
        "http://localhost:5000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

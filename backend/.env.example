# VibeNote Environment Variables Configuration Example
# Copy this file to .env and fill in your actual API keys.

# Flask settings
SECRET_KEY=replace_with_a_secure_random_string_for_production
PORT=5000
DEBUG=True

# API Keys (obtain from respective platforms)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Token (required for pyannote.audio models, e.g. speaker diarization)
HF_TOKEN=your_huggingface_token_here

# Headless Bot Settings
DISPLAY=:99
BOT_NAME=VibeNote Bot
